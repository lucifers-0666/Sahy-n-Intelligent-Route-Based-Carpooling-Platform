PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/sahyan
JWT_SECRET=your_secure_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

